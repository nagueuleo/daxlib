/// lperin.intervalcolor
/// Version       : 1.0.0
/// Description   : Returns green for maximum, red for minimum and blue otherwise
function 'lperin.intervalcolor.LineColor' =
        (
            ValueKPI: NUMERIC,
            MinKPI: NUMERIC,
            MaxKPI: NUMERIC
        )
        =>

        VAR is_max =
            ValueKPI = MaxKPI

        VAR is_min =
            ValueKPI = MinKPI

        VAR Result =
            SWITCH(
                TRUE(),
                is_max, "green",
                is_min, "red",
                "blue"
            )

        RETURN
            Result

    annotation DAXLIB_PackageId = lperin.intervalcolor

    annotation DAXLIB_PackageVersion = 1.0.0

